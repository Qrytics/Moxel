{
	"name": "moxel",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Moxel \u2014 local-first pixel art, animation and Minecraft texture editor in the browser.",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"signal": "node signaling/server.mjs",
		"e2e": "node scripts/e2e.mjs",
		"icons": "node scripts/gen-icons.mjs",
		"verify": "npm run lint && npm run check && npm test && npm run build"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"gifenc": "^1.0.3",
		"three": "^0.180.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^22.20.5",
		"@types/three": "^0.180.0",
		"@types/ws": "^8.18.2",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.5.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.3.6",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^3.2.7",
		"ws": "^8.22.0"
	}
}
